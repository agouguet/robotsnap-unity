* {
    --bg-primary: rgb(231, 234, 236);
    --bg-secondary: rgb(255, 255, 255);
    --sidebar-bg: rgb(255, 255, 255);
    --panel-bg: rgba(255, 255, 255, 0.92);
    /* It floats over the shot of the simulation, so it keeps some of it; opaque enough that its labels stay
       readable over a bright floor. */
    --viz-panel-bg: rgba(255, 255, 255, 0.90);
    --card-bg: rgb(255, 255, 255);
    --text-primary: rgb(15, 23, 42);
    --text-secondary: rgb(71, 85, 105);
    --text-secondary-muted: rgb(100, 116, 139);
    --accent: rgb(37, 99, 235);
    --accent-soft: rgb(59, 130, 246);
    --accent-glow: rgba(37, 99, 235, 0.15);
    --border-color: rgb(226, 232, 240);
    --button-bg: rgb(241, 245, 249);
    --button-hover: rgb(199, 204, 211);
    --title-corner-bg: rgb(255, 255, 255);
    --title-corner-color: rgb(37, 99, 235);
    --dropdown-bg: rgb(255, 255, 255);
    --dropdown-text: rgb(15, 23, 42);
    --icon-tint: rgb(22, 26, 31);
    --scrollbar-track: rgba(15, 23, 42, 0.05);
    --scrollbar-dragger: rgba(100, 116, 139, 0.45);
    --scrollbar-dragger-hover: rgba(71, 85, 105, 0.75);
}

.dark-mode * {
    --bg-primary: rgb(11, 17, 32);
    --bg-secondary: rgb(30, 41, 59);
    --sidebar-bg: rgb(15, 23, 42);
    --panel-bg: rgba(30, 41, 59, 0.85);
    /* It floats over the shot of the simulation, so it keeps some of it; opaque enough that its labels stay
       readable over a bright floor. */
    --viz-panel-bg: rgba(15, 23, 42, 0.86);
    --card-bg: rgb(30, 41, 59);
    --text-primary: rgb(241, 245, 249);
    --text-secondary: rgb(148, 163, 184);
    --text-secondary-muted: rgb(100, 116, 139);
    --accent: rgb(59, 130, 246);
    --accent-soft: rgb(96, 165, 250);
    --accent-glow: rgba(59, 130, 246, 0.2);
    --border-color: rgb(51, 65, 85);
    --button-bg: rgb(51, 65, 85);
    --button-hover: rgb(71, 85, 105);
    --title-corner-bg: rgb(30, 41, 59);
    --title-corner-color: rgb(96, 165, 250);
    --dropdown-bg: rgb(30, 41, 59);
    --dropdown-text: rgb(241, 245, 249);
    --icon-tint: rgb(241, 245, 249);
    --scrollbar-track: rgba(148, 163, 184, 0.08);
    --scrollbar-dragger: rgba(148, 163, 184, 0.45);
    --scrollbar-dragger-hover: rgba(203, 213, 225, 0.7);
}

/* ===== GLOBAL ROOT ===== */
.root {
    background-color: var(--bg-primary);
    background-size: cover;
}

.root,
#MainContainer,
#MainContent,
.main-container,
.main-content {
    height: 100%;
    width: 100%;
}

.main-container {
    background-color: var(--bg-primary);
    flex-direction: column;
}

.main-row {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.main-content {
    flex-grow: 1;
    height: 100%;
    min-height: 0;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0);
}

/* ===== STATUS BAR ===== */
.status-bar {
    background-color: var(--bg-secondary);
    /* border-top: 1px solid var(--border-color); */
    height: 28px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
}

.status-message {
    font-size: 12px;
    color: var(--text-secondary);
    flex-grow: 1;
    /* The message gives way before the chips do, so a long scenario name never pushes them out. */
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    -unity-text-overflow-position: end;
}

.status-time {
    font-size: 12px;
    color: var(--text-secondary);
    margin-left: 16px;
}

/* Quiet chips on the right of the bar: one for the agents, one for the ROS bridge. */
.status-chip {
    flex-direction: row;
    align-items: center;
    height: 18px;
    margin-left: 8px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 9px;
    background-color: var(--button-bg);
}

.status-chip-icon {
    width: 12px;
    height: 12px;
    margin-right: 5px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.75;
}

.status-chip-label {
    font-size: 12px;
    color: var(--text-secondary);
}

.status-ros-dot {
    width: 8px;
    height: 8px;
    margin-right: 5px;
    border-radius: 4px;
    background-color: var(--text-secondary-muted);
}

.status-ros-dot.is-online {
    background-color: rgb(34, 197, 94);
}

/* The ROS chip is the bar's one clickable chip. A button carries the runtime theme's own background image,
   radius and padding, none of which are the pill of the bar, so the chip's shape is restated for it; and the
   armed state fills it with the same green the online dot uses, rather than bringing a colour of its own. */
#StatusRos {
    border-width: 0;
    border-radius: 9px;
    padding: 0 8px;
    background-color: var(--button-bg);
    background-image: none;
}

#StatusRos:hover {
    background-color: var(--button-hover);
    background-image: none;
}

#StatusRos.is-ros-controlled {
    background-color: rgb(34, 197, 94);
}

#StatusRos.is-ros-controlled .status-chip-label {
    color: rgb(255, 255, 255);
}

.app-menu-button {
    width: 24px;
    height: 24px;
    margin-left: 8px;
    padding-left: 0;
    padding-right: 0;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-secondary);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.app-menu-button:hover {
    background-color: var(--button-bg);
    color: var(--text-primary);
}

.is-hidden {
    display: none;
}

/* ===== GENERIC ELEMENTS ===== */
.unity-label {
    color: var(--text-primary);
    font-size: 12px;
}

.unity-panel {
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--border-color);
    border-radius: 4px;
    padding: 8px;
    margin: 4px;
}

.unity-button {
    background-color: var(--button-bg);
    border-width: 0;
    border-radius: 4px;
    padding: 6px 12px;
    color: var(--text-primary);
}

.unity-button:hover {
    background-color: var(--button-hover);
}

.button-icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    background-size: contain;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--icon-tint);
}

.button-label {
    color: var(--text-primary);
    font-size: 14px;
}

.top-bar {
    padding: 12px 16px;
}

.simulator-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text-primary);
}

.simulator-desc {
    font-size: 16px;
    color: var(--text-secondary);
    margin-top: 4px;
}

.panel {
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--border-color);
    border-radius: 6px;
    margin: 8px;
    padding: 8px;
    flex-direction: column;
}

#LogsPanel .unity-list-view__item {
    font-size: 10px;
    padding: 2px 6px;
}

.console-line {
    font-size: 11px;
    padding: 2px 4px;
    color: rgb(160, 255, 160);
}

.viz-toggle {
    margin: 2px 0;
}

.tab-pane {
    padding: 8px;
}

.view-dropdown {
    background-color: var(--dropdown-bg);
    border-radius: 8px;
    color: var(--dropdown-text);
    font-size: 12px;
    height: 32px;
    min-width: 80px;
    padding: 0 8px;
    border-width: 0;
}

.view-dropdown .unity-base-text-field__input {
    color: var(--dropdown-text);
}

/* The default runtime theme colours a popup field's own text for a dark panel, which leaves it
   unreadable on the light dropdown this project draws; the value has to be the reading colour. */
.view-dropdown .unity-popup-field__text {
    color: var(--dropdown-text);
}

.view-dropdown .unity-popup-field__arrow {
    color: var(--dropdown-text);
    width: 16px;
}

.dashboard-panel {
    position: relative;
    margin: 8px;
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--accent-glow);
    border-radius: 12px;
    padding: 16px 12px 12px 12px;
    transition: border-color 0.2s;
}

.dashboard-panel:hover {
    border-color: var(--accent-soft);
    background-color: var(--bg-secondary);
}

.panel-title-corner {
    position: absolute;
    top: -12px;
    left: 16px;
    background-color: var(--title-corner-bg);
    padding: 0 10px;
    font-size: 14px;
    letter-spacing: 1.2px;
    color: var(--title-corner-color);
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--accent-glow);
}

.panel-inner {
    flex-direction: column;
    margin-top: 6px;
}

.metric-line {
    color: var(--text-primary);
    font-size: 12px;
    margin-bottom: 6px;
}

/* ===== DROPDOWN STYLES ===== */
.unity-base-field__input {
    color: var(--text-secondary);
    background-color: var(--bg-secondary);
    border-color: var(--border-color);
    border-radius: 4px;
    --unity-cursor-color: var(--text-primary);
}

.unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--text-secondary);
}

.unity-base-field__label {
    color: var(--text-secondary);
    font-size: 28px;
    --unity-cursor-color: var(--text-primary);
}

.unity-base-dropdown .unity-scroll-view {
    background-color: var(--bg-secondary);
    color: var(--text-secondary);
    border-color: var(--border-color);
    border-radius: 4px;
}

.unity-base-dropdown__item {
    flex-grow: 1;
}

.unity-base-dropdown #unity-content-container {
    flex-direction: column;
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: var(--text-secondary);
}

.unity-base-dropdown__container-outer {
    border-color: var(--border-color);
    border-radius: 4px;
}

/* ================================================================
   SCROLLBARS
   Thin, quiet scrollbars so they stay readable without competing
   with the panels they belong to.
   ================================================================ */

.unity-scroller {
    background-color: transparent;
}

.unity-scroller--vertical {
    width: 10px;
    min-width: 10px;
    margin-left: 2px;
    margin-right: 2px;
}

.unity-scroller--horizontal {
    height: 10px;
    min-height: 10px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.unity-scroller .unity-scroller__slider {
    margin: 0;
}

.unity-scroller .unity-scroller__low-button,
.unity-scroller .unity-scroller__high-button,
.unity-scroller .unity-repeat-button {
    display: none;
}

.unity-scroller .unity-base-slider__tracker,
.unity-scroller .unity-base-slider__tracker:hover {
    background-color: var(--scrollbar-track);
    border-width: 0;
    border-radius: 5px;
}

.unity-scroller .unity-base-slider__dragger {
    background-color: var(--scrollbar-dragger);
    border-width: 0;
    border-radius: 5px;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    width: 8px;
    left: 1px;
    min-height: 30px;
}

.unity-scroller--horizontal .unity-base-slider__dragger {
    height: 8px;
    top: 1px;
    min-width: 30px;
}

.unity-scroller .unity-base-slider__dragger:hover:enabled,
.unity-scroller .unity-base-slider__dragger:active:enabled {
    background-color: var(--scrollbar-dragger-hover);
}
