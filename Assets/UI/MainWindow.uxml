<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="Sidebar" src="project://database/Assets/UI/Sidebar.uxml?fileID=9197481963319205126&amp;guid=c13731eb285ae0729a9f9a6f6118ce39&amp;type=3#Sidebar"/>
    <ui:Template name="SimulationTab" src="project://database/Assets/UI/Tabs/Simulator/uxml/Simulator.uxml?fileID=9197481963319205126&amp;guid=cbda52829e825662596fd6c254609f8a&amp;type=3#Simulator"/>
    <Style src="project://database/Assets/UI/MainWindow.uss?fileID=7433441132597879392&amp;guid=a8f8b32c4d27d9bedaf2031c6a9bf7d5&amp;type=3#MainWindow"/>
    <Style src="project://database/Assets/UI/ConfirmationDialog.uss?fileID=7433441132597879392&amp;guid=010bb023570045b791be4fb99ca50288&amp;type=3#ConfirmationDialog"/>
    <ui:VisualElement name="MainContainer" class="main-container">
        <ui:VisualElement class="main-row" style="flex-grow: 1; flex-direction: row; min-height: 0;">
            <ui:Instance template="Sidebar"/>
            <ui:VisualElement name="MainContent" class="main-content"/>
        </ui:VisualElement>
        <ui:VisualElement name="StatusBar" class="status-bar">
            <ui:Label name="StatusMessage" class="status-message"/>
            <ui:Label name="StatusTime" class="status-time"/>
            <ui:VisualElement name="StatusAgents" class="status-chip">
                <ui:VisualElement name="StatusAgentsIcon" class="status-chip-icon"/>
                <ui:Label name="StatusAgentsLabel" text="0 agents" class="status-chip-label"/>
            </ui:VisualElement>
            <!-- The ROS chip is the bar's one clickable chip: pressing it hands the robot the view is on to
                 ROS 2, and pressing it again takes that robot back to the scenario. The dot keeps saying
                 whether the bridge is reachable; the chip itself lights up while its robot obeys ROS. -->
            <ui:Button name="StatusRos" class="status-chip" tooltip="Click to hand the selected robot to ROS 2 control, or take it back to the scenario if ROS is already driving it. Acts on the robot the view follows, or on robot_1 when none is selected.">
                <ui:VisualElement name="StatusRosDot" class="status-ros-dot"/>
                <ui:Label name="StatusRosLabel" text="ROS 2" class="status-chip-label"/>
            </ui:Button>
            <!-- Power glyph rather than the old "..." menu: the icon names what the button does. The image and
                 its tint are the ones of the other icons of the bar; the button asks the application to quit. -->
            <ui:Button name="QuitAppButton" tooltip="Quit RobotSNAP" class="app-menu-button button-icon" style="margin-right: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
